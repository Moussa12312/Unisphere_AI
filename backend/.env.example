# Database
DATABASE_URL=postgresql://postgres:unisphereai73@localhost:5432/unisphere_ai

# Security
SECRET_KEY=your-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:3000,http://192.168.100.17:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@unisphere.ai

# OpenAI (for AI Assistant)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
QR_DIR=./qr_codes
DOCUMENTS_DIR=./documents

# Application
APP_NAME=UniSphere AI
APP_VERSION=2.0.0
ENVIRONMENT=development