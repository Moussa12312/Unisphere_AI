# ==========================================================
# UniSphere AI - Global Environment Variables (Docker & Production)
# ==========================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=unisphere_ai
POSTGRES_PORT=5432

# Application Security
SECRET_KEY=generate-a-strong-secret-key-for-jwt-tokens-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@unisphere.ai

# AI Assistant (Groq recommandé / OpenAI / Gemini)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# SMS Gateway (Orange / Twilio / Infobip / Webhook)
SMS_PROVIDER=generic_webhook
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=UniSphere
SMS_GATEWAY_URL=

# Environment
ENVIRONMENT=production
