# ==========================================================
# UniSphere AI - .gitignore
# ==========================================================

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
Backend/venv/
env/
.pytest_cache/
.mypy_cache/

# ===== Node & Next.js =====
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Environnement & Secrets =====
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example

# ===== Bases de données locales SQLite =====
*.db
*.sqlite
*.sqlite3
backend/unisphere.db
unisphere.db

# ===== Uploads & Médias générés =====
uploads/
qr_codes/
documents/

# ===== Fichiers temporaires & Scratch =====
scratch/
backend/scratch/
backend_routes.json
*.tmp
*.temp
*.bak

# ===== Archives & Sauvegardes =====
back/
front/
*.zip
*.tar.gz

# ===== Logs =====
*.log

# ===== IDE / OS =====
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini